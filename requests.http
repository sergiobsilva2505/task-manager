# curl -X POST http://localhost:8080/api/tasks
#  -H "Content-Type: application/json"
#  -d '{"title":"Teste hora","description":"verificando timestamp","priority":"LOW","dueDate":"2026-09-01T15:30:00"}'
POST http://localhost:8080/api/tasks
Content-Type: application/json

{
    "title": "Teste hora",
    "description": "verificando timestamp",
    "priority": "LOW",
    "dueDate": "2026-09-01T15:30:00"
}

