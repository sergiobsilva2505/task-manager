meta {
  name: Change Task Status - Success
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/tasks/{{taskId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-User-Id: {{currentUserId}}
}

body:json {
  {
    "status": "IN_PROGRESS"
  }
}

docs {
  Altera o status de uma tarefa existente (transição válida), exigindo
  que ela pertença ao usuário identificado pelo header X-User-Id.

  Depende das variáveis {{taskId}} e {{currentUserId}}. Rode "Register User"
  e "Create Task" antes.

  Resposta esperada: 200 OK, com o corpo da tarefa refletindo o novo status.
}
