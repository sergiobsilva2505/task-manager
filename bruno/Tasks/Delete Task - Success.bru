meta {
  name: Delete Task - Success
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{currentUserId}}
}

docs {
  Remove uma tarefa existente, exigindo que ela pertença ao usuário
  identificado pelo header X-User-Id.

  Depende das variáveis {{taskId}} e {{currentUserId}}. Rode "Register User"
  e "Create Task" antes.

  Resposta esperada: 204 No Content, sem corpo.
}
