meta {
  name: Delete Task - Success
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Remove uma tarefa existente, exigindo que ela pertença ao usuário
  identificado pelo token.

  Depende das variáveis {{taskId}} e {{token}}. Rode "Register User" (pasta Users) e "Login"
  e "Create Task" antes.

  Resposta esperada: 204 No Content, sem corpo.
}
