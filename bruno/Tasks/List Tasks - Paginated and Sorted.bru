meta {
  name: List Tasks - Paginated and Sorted
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/tasks?page=0&size=5&sortField=TITLE&sortDirection=ASC
  body: none
  auth: none
}

headers {
  X-User-Id: {{currentUserId}}
}

params:query {
  page: 0
  size: 5
  sortField: TITLE
  sortDirection: ASC
}

docs {
  Lista tarefas do usuário atual com paginação e ordenação customizadas.

  sortField aceita: TITLE, CREATED_AT, DUE_DATE, PRIORITY.
  sortDirection aceita: ASC, DESC.

  Resposta esperada: 200 OK.
}
