meta {
  name: List Tasks - Default
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/tasks
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Lista as tarefas do usuário identificado pelo token, com os
  valores padrão: page=0, size=20, sortField=CREATED_AT, sortDirection=DESC.

  Depende da variável {{token}}. Rode "Register User" (pasta Users) e "Login" (pasta Auth) antes.

  Resposta esperada: 200 OK, com content, page, size, totalElements e totalPages.
}
