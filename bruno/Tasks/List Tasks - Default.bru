meta {
  name: List Tasks - Default
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/tasks
  body: none
  auth: none
}

headers {
  X-User-Id: {{currentUserId}}
}

docs {
  Lista as tarefas do usuário identificado por X-User-Id, com os
  valores padrão: page=0, size=20, sortField=CREATED_AT, sortDirection=DESC.

  Depende da variável {{currentUserId}}. Rode "Register User" antes.

  Resposta esperada: 200 OK, com content, page, size, totalElements e totalPages.
}
