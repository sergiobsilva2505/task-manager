meta {
  name: Get Task By Id - Not Found
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tasks/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Exemplo de cenário de erro: busca por um id que não existe.

  Depende da variável {{token}}. Rode "Register User" (pasta Users) e "Login" (pasta Auth) antes.

  Resposta esperada: 404 Not Found, formato application/problem+json,
  com title "Task Not Found" e detail contendo o id buscado.
}
