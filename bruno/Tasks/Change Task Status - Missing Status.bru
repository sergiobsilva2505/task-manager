meta {
  name: Change Task Status - Missing Status
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/tasks/{{taskId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {}
}

docs {
  Exemplo de cenário de erro: corpo da requisição sem o campo "status".

  Depende das variáveis {{taskId}} e {{token}}. Rode "Register User" (pasta Users) e "Login"
  e "Create Task" antes.

  Resposta esperada: 400 Bad Request, formato application/problem+json,
  title "Validation Failed", com errors.status preenchido.
}
